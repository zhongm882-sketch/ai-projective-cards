{
  "name": "ai-projective-cards-server",
  "version": "0.1.0",
  "private": true,
  "description": "AI 投射卡后端：探索记录持久化、鉴权、成长统计",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "10.0.2",
    "@fastify/rate-limit": "10.2.2",
    "@node-rs/argon2": "2.0.2",
    "dotenv": "16.4.7",
    "fastify": "5.11.0",
    "jose": "5.9.6",
    "pg": "8.13.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "20.17.10",
    "@types/pg": "8.11.10",
    "tsx": "4.23.4",
    "typescript": "5.7.2",
    "vitest": "4.1.10"
  }
}

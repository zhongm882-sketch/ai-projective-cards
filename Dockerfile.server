FROM node:22-slim

WORKDIR /app

# 国内构建加速：npm 走淘宝镜像
RUN npm config set registry https://registry.npmmirror.com

COPY server/package.json server/package-lock.json ./
RUN npm ci

COPY server/ ./
RUN npm run build

EXPOSE 4000

# 每次启动先执行数据库迁移，再启动服务
CMD ["sh", "-c", "npm run migrate && node dist/index.js"]
